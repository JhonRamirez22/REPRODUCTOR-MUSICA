# PostgreSQL local de desarrollo (no uses estos valores en producción).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://reproductor:reproductor_local@localhost:5432/reproductor
COOKIE_SECRET=reemplaza-esto-por-un-secreto-local-de-al-menos-32-caracteres
# Credencial propia desde https://developer.jamendo.com/; sin ella el catálogo queda desactivado.
# JAMENDO_CLIENT_ID=tu-client-id
MAX_PLAYLISTS_PER_OWNER=50
MAX_TRACKS_PER_PLAYLIST=500
BODY_LIMIT_BYTES=16384
RATE_LIMIT_MAX=120

# La integración puede borrar filas de esta base. Descomenta solo si levantas test-db.
# TEST_DATABASE_URL=postgres://reproductor:reproductor_local@localhost:15433/reproductor_test
